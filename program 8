2.Create a procedure to find greatest of 2 numbers.
mysql> delimiter //


mysql> create procedure greatest(in a int,b int)
    -> begin
    -> declare max_val int;
    -> if a>=b then
    -> set max_val=a;
    -> else 
    -> set max_val=b;
    -> end if;
    -> select max_val as 'greatest among 2';
    -> end //
Query OK, 0 rows affected (0.00 sec)

mysql> delimiter ;
mysql> call greatest(5,7); 
